    "@types/simple-peer": "^9.11.9",
    "@upstash/redis": "^1.38.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.14",
    "isomorphic-dompurify": "^3.19.0",
    "livekit-client": "^2.22.0",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^1.34.0",
    "marked": "^18.0.11",
    "nanoid": "^6.0.1",
    "next": "15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "shadcn": "^4.19.0",
    "simple-peer": "^9.11.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
